# PROPUESTA (no activa): configuración probada el 2026-11-15 que hace funcionar `sysmap impact/depende/archivo` en este repo.
# Para activarla: mover data/blender_user/ FUERA del repo (sysmap la escanea aunque esté en .gitignore y suma 520 archivos de un add-on ajeno)
# y decidir qué hacer con 3 endpoints que la web no llama (alarmas, cierres, verdes). Luego: cp sysmap.toml.propuesta sysmap.toml
# sysmap.toml, written by `sysmap init` from the folder layout. Read it, correct it, and answer the commented questions: they are what the folders cannot say.
[project]
name = "nasa"
python_roots = [".", "backend"]   # `from src.…` (raíz) y `apps.…` (backend/ está en el path de manage.py)
web_src = "web/src"
# openapi = "backend/openapi.json"   # the API contract, if there is one (it lets the map judge endpoints)
# web_call_base = "/api/v1"   # the path the web client puts before its calls (axios baseURL), if any
api_router_module = "backend/config/urls.py"
api_mount = "/api"
entrypoints = ["scripts"]   # runners de actas y utilidades: se ejecutan a mano
# data_dirs = []   # sin declarar: sysmap pediría un lector por carpeta de datos
