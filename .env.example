POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=alma
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Render + Neon: DATABASE_URL sustituye a POSTGRES_*; no pegar secretos en Git.
# DATABASE_URL se configura en Render con la conexión de Neon (sslmode=require).
DATABASE_SSL_REQUIRE=1

# --- Voz de ALMA (scripts/voz_alma.py; opcionales, no son secretos) ---
# Voz de Kokoro-82M: af_heart (defecto), bf_emma, af_nicole, af_bella, af_sky, bf_isabella…
ALMA_VOICE=af_heart
# 1 = eco/coro «holográfico» sutil (defecto); 0 = voz limpia
ALMA_FX=1
