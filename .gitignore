*.pyc
.venv/

.pytest_cache/
.mypy_cache/
.ruff_cache/
graphify-out/cache/
.env
.env.*
!.env.example
.vercel/
node_modules/
.next/
data/externos/

# voz de ALMA: modelo Kokoro-82M (Apache-2.0), se descarga, no se versiona
data/voz_modelo/
web/node_modules/
web/.next/

# lecturas crudas NUEVAS de SWPC (crecen sin límite con `ingestar_swpc --cada`): el manifiesto con sus hashes sí se versiona; las ya versionadas siguen
data/lecturas/swpc_*.json

# clips del buscador: marcas de regeneración
web/public/voice/search/*.txt

# perfil aislado de Blender (extensiones, assets descargados): se regenera
data/blender_user/
data/modelos/*.blend
*.blend1
data/entorno_vivo/

# vault de Obsidian generado por graphify (solo lectura humana; se regenera con /graphify . --obsidian)
graphify-out/obsidian/

# archivos locales de graphify (rutas de esta máquina) y su visor HTML: se regeneran
graphify-out/.graphify_*
graphify-out/graph.html
